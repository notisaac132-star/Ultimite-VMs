{
  "name": "ultimate-vms",
  "productName": "Ultimate VMs",
  "version": "1.0.0",
  "description": "Plug-and-play virtual machines: Windows, macOS and Linux from one simple menu",
  "main": "src/main.js",
  "author": "Isaac",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "build:macvm": "sh scripts/build-macvm.sh",
    "build:windows": "electron-builder --win --publish never",
    "build:mac": "npm run build:macvm && electron-builder --mac --publish never",
    "build:linux": "electron-builder --linux --publish never"
  },
  "devDependencies": {
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "yauzl": "^3.4.0"
  }
}
